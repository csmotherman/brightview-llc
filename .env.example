# Set this as a SERVER-SIDE environment variable in the deployment host.
# Never prefix with NEXT_PUBLIC_ and never commit the real Zolato webhook URL.
ZOLATO_INTAKE_WEBHOOK_URL=https://zolato.ai/api/intake/webhook/REPLACE_WITH_PRIVATE_VALUE

# Only set this when Zolato's optional X-Zolato-Secret has been configured.
# ZOLATO_INTAKE_SECRET=REPLACE_WITH_OPTIONAL_PRIVATE_VALUE

# --- SEO / launch switches (set on the PRODUCTION environment in Vercel; not secrets) ---
# Canonical production origin, no trailing slash. Until this is set, no canonical/Open Graph/sitemap URLs are emitted.
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
# Search engines stay blocked until this is exactly "true" AND NEXT_PUBLIC_SITE_URL is set AND the deployment is Production.
# Preview deployments are always noindex.
# SEO_ALLOW_INDEXING=true
