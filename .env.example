# Set this as a SERVER-SIDE environment variable in the deployment host.
# Never prefix with NEXT_PUBLIC_ and never commit the real Zolato webhook URL.
ZOLATO_INTAKE_WEBHOOK_URL=https://zolato.ai/api/intake/webhook/REPLACE_WITH_PRIVATE_VALUE

# Only set this when Zolato's optional X-Zolato-Secret has been configured.
# ZOLATO_INTAKE_SECRET=REPLACE_WITH_OPTIONAL_PRIVATE_VALUE
